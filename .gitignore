# dependencies
node_modules/

# build output
dist/
.astro/

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# scratch files used for local verification, not meant to be committed
*.tmp.mjs

# Rust build artifacts for the WASM examples
examples/target/

# WASM examples are compiled by CI and copied here on each build;
# the vendored mq_js_bundle.js loader (a plain file, not a directory)
# stays tracked.
public/wasm-examples/*/
