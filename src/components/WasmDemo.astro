---
interface Props {
  name: string;
  width?: number;
  height?: number;
}

const { name, width = 640, height = 480 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/wasm-examples/${name}/`;
---

<iframe
  src={src}
  width={width}
  height={height}
  loading="lazy"
  title={`Живой пример: ${name}`}
></iframe>

<style>
  iframe {
    display: block;
    max-width: 100%;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    margin-block: 1rem;
  }
</style>
