---
interface Props {
  name: string;
  width?: number;
  height?: number;
}

const { name, width = 720, height = 540 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/wasm-examples/${name}/`;
---

<div
  class="wasm-demo"
  style={`--wasm-demo-width: ${width}px; --wasm-demo-aspect-ratio: ${width} / ${height};`}
>
  <iframe src={src} loading="lazy" title={`Живой пример: ${name}`}></iframe>
  <button type="button" class="fullscreen-toggle" aria-label="Развернуть на весь экран">
    <svg class="icon-expand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
    </svg>
    <svg class="icon-collapse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 3v4a2 2 0 0 1-2 2H3m18 0h-4a2 2 0 0 1-2-2V3m0 18v-4a2 2 0 0 1 2-2h4M3 15h4a2 2 0 0 1 2 2v4" />
    </svg>
  </button>
</div>

<script>
  function initWasmDemos() {
    document.querySelectorAll('.wasm-demo').forEach((container) => {
      if (container.dataset.fsInit === 'true') return;

      const button = container.querySelector('.fullscreen-toggle');
      if (!button) return;

      const request = container.requestFullscreen?.bind(container) ?? container.webkitRequestFullscreen?.bind(container);
      const exit = document.exitFullscreen?.bind(document) ?? document.webkitExitFullscreen?.bind(document);

      if (!request || !exit) {
        button.hidden = true;
        return;
      }

      container.dataset.fsInit = 'true';

      const isFullscreen = () =>
        (document.fullscreenElement ?? document.webkitFullscreenElement) === container;

      button.addEventListener('click', () => {
        if (isFullscreen()) exit();
        else request();
      });

      const updateState = () => {
        const active = isFullscreen();
        button.classList.toggle('is-fullscreen', active);
        button.setAttribute(
          'aria-label',
          active ? 'Выйти из полноэкранного режима' : 'Развернуть на весь экран',
        );
      };
      document.addEventListener('fullscreenchange', updateState);
      document.addEventListener('webkitfullscreenchange', updateState);
    });
  }

  initWasmDemos();
  document.addEventListener('astro:page-load', initWasmDemos);
</script>

<style>
  .wasm-demo {
    position: relative;
    width: 100%;
    max-width: var(--wasm-demo-width);
    aspect-ratio: var(--wasm-demo-aspect-ratio);
    margin-block: 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
    background: black;
  }

  .wasm-demo:fullscreen {
    max-width: none;
    width: 100vw;
    height: 100vh;
    border-radius: 0;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .fullscreen-toggle {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: rgba(0, 0, 0, 0.55);
    color: white;
    cursor: pointer;
  }

  .fullscreen-toggle:hover {
    background: rgba(0, 0, 0, 0.75);
  }

  .fullscreen-toggle svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .icon-collapse {
    display: none;
  }

  .fullscreen-toggle.is-fullscreen .icon-expand {
    display: none;
  }

  .fullscreen-toggle.is-fullscreen .icon-collapse {
    display: block;
  }
</style>
